+    /// Write one complete IP packet through the CDTunnel transport.
+    ///
+    /// Some transports, notably the TLS stream behind CoreDeviceProxy, may
+    /// buffer a successful `write_all`. The peer cannot ACK or answer a
+    /// service request until those bytes are flushed to the underlying socket.
+    async fn send_peer_packet(&mut self, packet: &[u8]) -> Result<(), std::io::Error> {
+        self.peer.write_all(packet).await?;
+        self.peer.flush().await?;
+        self.log_packet(packet)
+    }
