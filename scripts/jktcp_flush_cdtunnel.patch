+
+        let hp = handshake(&mut adapter, &mut test_rx, &mut test_tx).await;
+        let before = flushes.load(Ordering::SeqCst);
+
+        adapter.queue_send(b"afc payload", hp).unwrap();
+        adapter.write_buffer_flush().await.unwrap();
+
+        assert!(
